<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ── Network ────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>

    <!-- ── Camera & Microphone (Agora calling, profile photos, verification) -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

    <!-- ── Storage / Photos ────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>

    <!-- ── Notifications (Android 13+) ────────────────────────────────── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- ── Call Ringing (full-screen intent over lock screen) ──────────── -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- ── Phone State (caller ID detection) ──────────────────────────── -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>

    <!-- ── Bluetooth (Agora audio routing) ────────────────────────────── -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"/>

    <!-- ── Wake Lock (keep device awake during calls) ─────────────────── -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- ── Ongoing-call foreground service ─────────────────────────────
         Not cosmetic. Since Android 9 a process with no foreground activity
         and no foreground service is handed *silence* from the microphone
         rather than an error, so a minimised call keeps every "connected"
         indicator lit while the other side hears nothing. CallForegroundService
         is what keeps the capture real once the call screen is off screen —
         and what puts the call in the notification tray so it can be tapped
         back open. The typed permissions are required from Android 14. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>

    <!-- ── Battery optimisation exemption ──────────────────────────────
         Measured on an Infinix X6853: FCM reaches the app in the foreground,
         in the background and after its process is killed, but NOT once the
         app has been force-stopped - and the OEM cleaner
         (com.transsion.phonemaster) force-stops apps that are still being
         battery-optimised. A force-stopped app carries FLAG_STOPPED and
         Android delivers it no broadcasts at all, FCM included, so no client
         or server change can recover it.
         Google's policy permits this permission for apps whose core function
         is calling. See PermissionsService.requestCallReliability. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>


    <application
        android:label="Hamqadam"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="high_importance_channel" />
        <!-- Applied to notifications Android draws itself, i.e. every push
             that lands while the app is not running. Without these the icon is
             a grey square with no tint. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- showWhenLocked / turnScreenOn must be declared, and MainActivity
             switches them straight back OFF unless a call is ringing.

             Both halves are necessary. Android decides whether an activity may
             appear over the keyguard when it launches it - before a line of our
             code runs - so without the manifest attribute a full-screen intent
             on a locked phone is simply refused and the member gets a silent
             "New notification" line instead of a ringing screen. Verified: with
             these removed, a locked phone never rang.

             But leaving them on permanently makes the launcher activity a
             lock-screen surface for every ordinary launch, and a window shown
             over the keyguard is given the short keyguard display timeout
             rather than the member's own sleep setting - the reported "jab bhi
             app chalta hai screen 5 second me off ho jati hai".

             So the manifest grants the *capability* and MainActivity.onCreate
             revokes it at runtime (`setShowWhenLocked(false)`) whenever there is
             no ringing call. See MainActivity.kt. -->
        <!-- supportsPictureInPicture / resizeableActivity: a video call shrinks
             into a floating window when the member leaves it (back, home or
             recents) instead of ending. Both are needed — Android refuses PiP
             outright without the first, and cannot draw a non-resizeable
             activity at PiP size. See MainActivity.enterPip. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Holds the microphone (and the camera, on a video call) open while
             the call is minimised, and owns the ongoing-call tray entry. -->
        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="microphone|camera"/>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
