# Uncomment this line to define a global platform for your project
platform :ios, '15.5'

# Every pod must build against at least this iOS version.
#
# `platform :ios` above only sets the DEFAULT for pods that declare nothing;
# a pod whose podspec still says `s.ios.deployment_target = '9.0'` keeps its
# own value, and `flutter_additional_ios_build_settings` only raises it as far
# as Flutter's own minimum. Xcode 27 refuses to build for the simulator below
# 15.0, so those stale pods failed the build with:
#   "IPHONEOS_DEPLOYMENT_TARGET is set to 9.0, but the range of supported
#    deployment target versions is 15.0 to 27.0.x"
# The post_install hook at the bottom raises them to this value.
IOS_MINIMUM_DEPLOYMENT_TARGET = '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Ensure CocoaPods uses the existing Podfile.lock as-is and does not
# attempt CDN re-resolution when Flutter calls `pod install` internally.
install! 'cocoapods', :disable_input_output_paths => true



project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']

      # Raise only — a pod that legitimately needs a NEWER iOS than ours keeps
      # its own value instead of being silently dragged backwards.
      if current.nil? || current.to_s.empty? || current.to_f < IOS_MINIMUM_DEPLOYMENT_TARGET.to_f
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = IOS_MINIMUM_DEPLOYMENT_TARGET
      end
    end
  end

  # Resource-bundle and aggregate targets inherit from the generated Pods
  # project, which carries its own copy of the setting.
  installer.pods_project.build_configurations.each do |config|
    current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
    if current.nil? || current.to_s.empty? || current.to_f < IOS_MINIMUM_DEPLOYMENT_TARGET.to_f
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = IOS_MINIMUM_DEPLOYMENT_TARGET
    end
  end
end
