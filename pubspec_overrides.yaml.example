# Copy to `pubspec_overrides.yaml` ONLY when you need to work on the iOS
# Simulator, then run `flutter pub get` and `(cd ios && pod install)`.
#
# Google ML Kit ships no arm64-simulator slice, so the real plugin cannot be
# linked into a Simulator build. This swaps in a no-op stub so the rest of the
# app still runs there.
#
# WHAT IT COSTS: CNIC OCR silently reports "no number found" for every photo.
# It does not throw and it does not log a warning of its own — the only clue is
# the recogniser reporting 0 characters. Delete pubspec_overrides.yaml (and run
# pub get again) before building for Android or a real iOS device.
#
# pubspec_overrides.yaml is gitignored on purpose so this can never reach
# another machine or a release build.
dependency_overrides:
  google_mlkit_text_recognition:
    path: dev_stubs/google_mlkit_text_recognition
